# Demo mode never calls paid services. Set live only after adding keys.
DATA_MODE=demo
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Optional extra grounded place guidance (adds a Gemini Maps request).
ENABLE_MAPS_GROUNDING=false
PROVIDER_TIMEOUT_MS=12000
RATE_LIMIT_MAX=30
# Required if NODE_ENV=production and DATA_MODE=live.
# Keep this in a frontend SERVER proxy, never in browser code.
API_ACCESS_TOKEN=
